# Copy to `.env` and adjust (`make setup` does this for you). `.env` is git-ignored: never commit real credentials.
# Every value below is a safe placeholder intended for local development only.

# --- Application ---------------------------------------------------------------------------------------
# One of: development, test, staging, production.
APP_ENV=development
# Build metadata, normally injected by the build pipeline.
# APP_VERSION=0.0.0-dev
# APP_COMMIT=unknown
# APP_BUILD_DATE=

# --- HTTP server ---------------------------------------------------------------------------------------
# Defaults to 127.0.0.1 locally and 0.0.0.0 when deployed.
# HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# HTTP_MAX_BODY_SIZE_BYTES=1048576
# Time allowed for in-flight requests to finish after SIGTERM/SIGINT.
# SHUTDOWN_TIMEOUT_SECONDS=15

# --- Logging -------------------------------------------------------------------------------------------
# Levels: trace, debug, info, notice, warning, error, critical. Formats: console, json.
# LOG_LEVEL=debug
# LOG_FORMAT=console

# --- PostgreSQL ----------------------------------------------------------------------------------------
# Used by docker-compose.yml to provision the local database.
POSTGRES_USER=engine
POSTGRES_PASSWORD=engine_dev_password
POSTGRES_DB=scientific_engine
# Required in every environment. Matches the values above for a locally running database.
DATABASE_URL=postgres://engine:engine_dev_password@localhost:5432/scientific_engine
# DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=2
# DATABASE_POOL_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Container stack ----------------------------------------------------------------------------------
# Memory limit of the application containers started by docker-compose.yml.
# APP_MEMORY_LIMIT=512m

# --- Calculation limits --------------------------------------------------------------------------------
# Time budget of one calculation; a calculation that exceeds it is cancelled and recorded as failed.
# CALCULATION_TIMEOUT_MS=2000
# Most calculations in one batch request, and how many of them run at the same time.
# BATCH_MAX_SIZE=100
# BATCH_CONCURRENCY=8

# --- Sentry --------------------------------------------------------------------------------------------
# Leave unset to disable error reporting.
# SENTRY_DSN=
# SENTRY_SAMPLE_RATE=1.0
